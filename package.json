{
  "name": "discord_loup_garou",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot to play Loup Garou games",
  "dependencies": {
    "@llamaindex/openai": "^0.4.20",
    "discord.js": "^14.23.2",
    "dotenv": "^17.2.3",
    "generic-pool": "^3.9.0",
    "googleapis": "^164.0.0",
    "graceful-fs": "^4.2.3",
    "isomorphic-fetch": "^3.0.0",
    "keyv": "^5.5.3",
    "llamaindex": "^0.12.0",
    "mocha": "^11.7.4",
    "promised-sqlite3": "^2.1.0",
    "sqlite3": "^5.1.7",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ytdl-core": "^4.11.5"
  },
  "scripts": {
    "start": "node src/discordlgbot.js",
    "run": "pm2 start src/discordlgbot.js --name lgdb",
    "restart": "pm2 restart lgdb",
    "stop": "pm2 stop lgdb",
    "test": "mocha \"test/persistence/**/*.js\" \"test/services/**/*.js\" \"test/functions/**/*.mocha.js\" \"test/utils/**/*.mocha.js\" \"test/slashCommands/**/*.mocha.js\" \"test/lg/**/*.mocha.js\" --exit",
    "test:coverage": "nyc mocha \"test/persistence/**/*.js\" \"test/services/**/*.js\" \"test/functions/**/*.mocha.js\" \"test/utils/**/*.mocha.js\" \"test/slashCommands/**/*.mocha.js\" \"test/lg/**/*.mocha.js\" --exit",
    "coverage": "nyc report --reporter=html",
    "postinstall": "patch-package"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "nyc": "^17.1.0",
    "patch-package": "^8.0.0"
  },
  "nyc": {
    "reporter": [
      "text-summary",
      "html"
    ],
    "all": false,
    "check-coverage": true,
    "statements": 80,
    "branches": 80,
    "functions": 80,
    "lines": 80,
    "include": [],
    "exclude": [
      "test/**",
      "**/src/lg/**",
      "**/src/commands/**",
      "**/src/discordlgbot.js",
      "**/src/utils/embed.js",
      "**/src/utils/message.js",
      "**/src/functions/cmds/**",
      "**/src/services/index.js",
      "**/src/slashCommands/**",
      "src/slashCommands/**"
    ]
  }
}
